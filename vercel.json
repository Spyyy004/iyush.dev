{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/football/tools/transfer-calculator",
      "destination": "/football/tools/transfer",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/football/tools/similarity",
      "has": [
        {
          "type": "query",
          "key": "player"
        }
      ],
      "destination": "/api/sim-page"
    },
    {
      "source": "/football/tools/transfer",
      "has": [
        {
          "type": "query",
          "key": "player"
        }
      ],
      "destination": "/api/transfer-page"
    }
  ]
}